# Copy to scripts/local.env (git-ignored). When DEVELOPMENT_TEAM is set, scripts/build.sh signs
# with your Apple Development certificate so macOS keeps the Screen Recording permission across
# rebuilds. Without it the app is ad-hoc signed and may be asked for permission again after a rebuild.
DEVELOPMENT_TEAM=YOUR_TEAM_ID

# Used by scripts/release.sh only: the name of a notarytool keychain profile, created once with
#   xcrun notarytool store-credentials "ScreenCapNotary" --apple-id you@example.com \
#     --team-id YOUR_TEAM_ID --password <app-specific password>
NOTARY_PROFILE=YOUR_PROFILE_NAME
